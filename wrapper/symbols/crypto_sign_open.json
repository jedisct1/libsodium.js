{
  "name": "crypto_sign_open",
  "type": "function",
  "inputs": [
    {
      "name": "signedMessage",
      "type": "minsized_buf",
      "min_length": "libsodium._crypto_sign_bytes()"
    },
    {
      "name": "publicKey",
      "type": "buf",
      "length": "libsodium._crypto_sign_publickeybytes()"
    }
  ],
  "outputs": [
    {
      "type": "buf",
      "name": "message",
      "length": "signedMessage_length - libsodium._crypto_sign_bytes()"
    }
  ],
  "target": "libsodium._crypto_sign_open(message_address, null, signedMessage_address, ..._to_u64(signedMessage_length), publicKey_address) | 0",
  "assert_retval": [
    {
      "condition": "=== 0",
      "or_else_throw": "incorrect signature for the given public key"
    }
  ],
  "return": "_format_output(message, outputFormat)"
}
